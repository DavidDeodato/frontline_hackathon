# Runtime credentials stay in the server environment. Never expose them to Vite.
OPENAI_API_KEY=
OPENAI_MODEL=
FRONTLINE_PROVIDER_MODE=fixture
HOST=127.0.0.1
PORT=3000
FRONTLINE_DATA_DIR=./data
FRONTLINE_PUBLIC_ORIGIN=http://localhost:3000
FRONTLINE_SECURE_COOKIES=false
# Operational quota: preserved across restart; distinct from development test rounds.
FRONTLINE_MAX_REQUESTS=36
FRONTLINE_MAX_OUTPUT_TOKENS=46800